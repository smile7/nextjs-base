{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "schedule": ["before 6am on monday"],
  "timezone": "Europe/Sofia",
  "rangeStrategy": "pin",
  "automerge": false,
  "packageRules": [
    {
      "description": "Group minor and patch updates weekly",
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "minor and patch dependencies"
    },
    {
      "description": "Platform majors need a manual check and a re-run of the Phase 00 deploy spike",
      "matchPackageNames": [
        "next",
        "@opennextjs/cloudflare",
        "wrangler",
        "sanity",
        "next-sanity",
        "/^@sanity//"
      ],
      "matchUpdateTypes": ["major"],
      "groupName": null,
      "automerge": false,
      "dependencyDashboardApproval": true
    },
    {
      "description": "ADR-009: TypeScript stays on 6.0.x and ESLint on 9.x until lint plugins support newer majors",
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<6.1.0"
    },
    {
      "description": "ADR-009",
      "matchPackageNames": ["eslint"],
      "allowedVersions": "<10"
    }
  ]
}
